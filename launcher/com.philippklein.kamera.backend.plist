<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  KaMeRa backend as a user LaunchAgent.

  Why an agent rather than a process the applet spawns: an AppleScript applet
  quits as soon as its script ends, and macOS 26+ then terminates what that
  applet spawned. Measured 2026-09-18 — applet exits at T, launcher.py takes a
  SIGTERM at T+0.6s, uvicorn is gone at T+1.2s. Neither `perl POSIX::setsid()`
  nor `launchctl submit` escapes it: both still run in the applet's bootstrap
  context. A job in the gui/<uid> domain belongs to launchd, so the applet's
  exit cannot reap it.

  RunAtLoad/KeepAlive are false on purpose: the backend starts when the user
  opens KaMeRa (the applet kickstarts this job), and stops when they quit the
  window (launcher.py's supervisor terminates it). KeepAlive would fight that
  and respawn a backend the user just closed.

  Install / update:  launcher/install_agent.sh
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.philippklein.kamera.backend</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/philippklein/dev/kamera/start.sh</string>
        <string>--no-browser</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/philippklein/dev/kamera</string>
    <!--
      A LaunchAgent does NOT inherit the login shell's PATH. launchd hands the
      job /usr/bin:/bin:/usr/sbin:/sbin, and `/bin/bash start.sh` is neither
      interactive nor a login shell, so no profile is ever read.

      That silently broke every RAF and HIF analysed through the app:
      exiftool lives in /opt/homebrew/bin, pyexiftool could not find it, and
      extract_exif returned an all-None dict. The photo still scored, so the
      row was written with camera, shot_at, lens, focal length, aperture,
      shutter and ISO all NULL — 1 530 rows of shooting_log, ~23% of the
      corpus, with no error anywhere. JPEG/NEF/3FR were unaffected because
      exifread is pure Python and needs no binary. `ollama` was equally
      unreachable, so the LLM explainer was off too.

      install_agent.sh rewrites this string with the installing shell's own
      PATH, so it follows the machine rather than hardcoding a Homebrew
      prefix. exif_parser.py additionally locates exiftool by absolute path
      as a second line of defence.
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__KAMERA_PATH__</string>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/tmp/kamera_launch.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/kamera_launch.log</string>
</dict>
</plist>
